{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "experience",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "name_localized": {
          "$ref": "#/$defs/localized"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "availability": {
          "$ref": "#/$defs/localized"
        }
      },
      "additionalProperties": false
    },
    "about": {
      "type": "string"
    },
    "experience": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experience"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/education"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "items"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "label_localized": {
            "$ref": "#/$defs/localized"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "familiar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "qualifier"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "qualifier": {
            "type": "string"
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "level"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string"
          }
        }
      }
    },
    "do_not_claim": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "forbid_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "message"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "cover_max_words": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localized": {
      "type": "object",
      "description": "String values keyed by language codes matching ^[a-z]{2}(-[A-Za-z]+)?$. The minimal validator does not enforce language keys or schema-valued additionalProperties.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "experience": {
      "type": "object",
      "required": [
        "company",
        "title",
        "dates",
        "bullets"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "dates": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "title",
        "bullets"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tech": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "link_label": {
          "type": "string"
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "education": {
      "type": "object",
      "required": [
        "institution",
        "degree",
        "years"
      ],
      "properties": {
        "institution": {
          "type": "string"
        },
        "degree": {
          "type": "string"
        },
        "years": {
          "type": "string"
        }
      }
    }
  }
}
